{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "ask",
      "git diff*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git describe*": "allow",
      "git config*": "allow",
      "git --version": "allow",
      "gh *": "ask",
      "gh auth status*": "allow",
      "gh repo view*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh pr status*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh search*": "allow",
      "gh release view*": "allow",
      "gh release list*": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "gh status*": "allow",
      "rm *": "ask"
    },
    "external_directory": {
       "/tmp/**": "allow"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "@modelcontextprotocol/server-fetch"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "firecrawl": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "@mendable/firecrawl-mcp-server"],
      "env": {
        "FIRECRAWL_API_KEY": "fc-73da408b2ed543e981dc319074da0ec1"
      }   
    },
    "shadcn-ui": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "@heilgar/shadcn-ui-mcp-server"]
    }
  }
}