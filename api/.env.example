# Database
MYSQL_ROOT_PASSWORD=root_secret
DB_USERNAME=app_user
DB_PASSWORD=app_secret
# TLS to the database (false only for local docker network)
DB_SSL=false
DB_ALLOW_PUBLIC_KEY=true

# JWT (required, min 32 bytes — app refuses to start without it)
JWT_SECRET=change-me-to-a-256-bit-secret-min-32-bytes
# Set to true when serving the UI over HTTPS
COOKIE_SECURE=false

# SMTP (prod only — dev uses Mailpit)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# App
MAIL_FROM=noreply@example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
INSTITUTION_NAME=Université Hassan II
INSTITUTION_LOGO_URL=
