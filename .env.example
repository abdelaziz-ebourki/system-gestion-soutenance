# Database
MYSQL_ROOT_PASSWORD=root_secret
DB_USERNAME=app_user
DB_PASSWORD=app_secret
# TLS to the database (false only for local docker network)
DB_SSL=false
DB_ALLOW_PUBLIC_KEY=true

# JWT (required, min 32 bytes — app refuses to start without it)
JWT_SECRET=change-me-to-a-256-bit-secret-min-32-bytes
# Must be true in production (HTTPS). Only false for plain-HTTP local runs.
COOKIE_SECURE=true

# SMTP (required in production — the compose mailpit is a dev sink, override these)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# App
MAIL_FROM=noreply@example.com
CORS_ORIGINS=https://soutenance.example.com
INSTITUTION_NAME=Université Hassan II
INSTITUTION_LOGO_URL=

# First boot only (prod has no demo seed): initial admin, created once on empty DB.
# Rotate or delete after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# Public hostname served by Caddy (automatic HTTPS). Use a real domain in prod.
APP_HOST=soutenance.example.com

# Frontend API base: keep /api (same-origin via Caddy)
VITE_API_BASE_URL=/api
