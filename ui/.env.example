# API base URL (default: /api)
VITE_API_BASE_URL=/api

# App branding (displayed in login page, sidebar, metadata)
VITE_APP_NAME=Your App Name
VITE_APP_SUBTITLE=Your App Subtitle
VITE_APP_DESCRIPTION=Your app description.

# Institution info
VITE_APP_INSTITUTION=Your Institution Name

# Email domain for placeholders (e.g. firstname.lastname@domain)
VITE_APP_EMAIL_DOMAIN=your-institution.ma

# Support contact
VITE_APP_SUPPORT_EMAIL=support@your-institution.ma

# GitHub repository URL
VITE_APP_GITHUB=https://github.com/your-org/your-repo
